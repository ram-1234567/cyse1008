rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write access only if the user is authenticated
    match /{document=**} {
      allow read, write: if request.auth != null; // Requires authentication
    }

    // Alternatively, you can have more granular control over collections
    // Example: Only allow authenticated users to write to a "posts" collection
    match /posts/{postId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Example: Allow only certain roles (admin) to access sensitive data
    match /admin/{documentId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
